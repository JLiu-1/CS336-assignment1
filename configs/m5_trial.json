{
  "description": "M5 短试跑：4,096,000 tokens；沿用 5000 步日程。与完整运行的前缀可比较，不能和短日程混比。",
  "model": {
    "vocab_size": 10000,
    "context_length": 256,
    "d_model": 256,
    "num_layers": 4,
    "num_heads": 8,
    "d_ff": 704,
    "rope_theta": 10000,
    "use_rope": true,
    "use_norm": true,
    "ffn_type": "swiglu",
    "tie_embeddings": false
  },
  "training": {
    "batch_size": 8,
    "gradient_accumulation": 4,
    "total_steps": 500,
    "schedule_steps": 5000,
    "max_lr": 0.001,
    "min_lr": 0.0001,
    "warmup_steps": 100,
    "beta1": 0.9,
    "beta2": 0.95,
    "weight_decay": 0.01,
    "eps": 1e-8,
    "max_grad_norm": 1,
    "eval_every": 100,
    "eval_batches": 64,
    "eval_batch_size": 8,
    "eval_context_length": 256,
    "save_every": 100,
    "seed": 42,
    "precision": "fp32"
  }
}
